# ============================================================
# BrainFlow AI — example environment configuration
# Copy to .env and adjust. .env is gitignored — never commit secrets.
# ============================================================

# --- App ---
APP_NAME=BrainFlow AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# --- CORS ---
# Comma-separated list of allowed origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# SQLite is the default (file lives next to the backend package).
# PostgreSQL example:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/brainflow
# DATABASE_URL=sqlite:///./brainflow.db

# --- Admin account (single-operator demo) ---
# These values are used to seed the one admin user on first run.
# Change ADMIN_PASSWORD before sharing the demo, or reset the DB after editing.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=BrainFlow@2026

# --- Sessions ---
SESSION_TTL_HOURS=8
SESSION_COOKIE_NAME=brainflow_session
COOKIE_SECURE=false

# --- Scheduler (background operational scans) ---
SCHEDULER_ENABLED=true
SCAN_INTERVAL_MINUTES=5

# --- External context ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
NAGER_DATE_BASE_URL=https://date.nager.at/api/v3
EXTERNAL_TIMEOUT_SECONDS=6
PUBLIC_HOLIDAY_COUNTRY=ET

# --- Gemini (optional) ---
# Leave blank to use the deterministic fallback provider.
# Add a real key to enable LLM-enhanced copilot answers and customer drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=20
